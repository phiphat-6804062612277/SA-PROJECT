# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่า (ห้าม commit ไฟล์ .env)
PORT=5000

# MongoDB Atlas หรือ local เช่น mongodb://127.0.0.1:27017/solify
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/solify?retryWrites=true&w=majority

# สตริงสุ่มยาวๆ สำหรับเซ็น JWT  (สร้างได้ด้วย: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=change-me

# โดเมนของ frontend ที่อนุญาตให้เรียก API (คั่นด้วย , ได้หลายโดเมน)
CLIENT_ORIGIN=http://localhost:3000

# รหัสลับสำหรับสมัครบัญชี Admin ผ่านหน้า Sign up (ไม่ตั้ง = ปิดการสมัคร Admin)
# บัญชี Admin สำหรับ Demo ใช้ `npm run seed` จะได้ admin@solify.test / 123456
ADMIN_SIGNUP_CODE=change-me-admin-code

# ลืมรหัสผ่าน (OTP)
# true  = ไม่ส่งอีเมลจริง แต่แสดง OTP บนหน้าจอ (เหมาะกับ Demo)  — ค่าเริ่มต้นเมื่อ NODE_ENV != production
# false = ต้องตั้ง RESEND_API_KEY + MAIL_FROM เพื่อส่งอีเมลจริง
OTP_DEMO_MODE=true
# (ไม่บังคับ) ส่งอีเมล OTP จริงผ่าน https://resend.com
RESEND_API_KEY=
MAIL_FROM=Solify <onboarding@resend.dev>

# Escrow: ปล่อยเงินให้ผู้ขายอัตโนมัติหลังจัดส่งกี่วัน (ค่าเริ่มต้น 7) / Worker ตรวจทุกกี่นาที (ค่าเริ่มต้น 60)
# ทดสอบเร็วๆ: AUTO_RELEASE_DAYS=0.001 และ AUTO_RELEASE_INTERVAL_MINUTES=1   (AUTO_RELEASE_ENABLED=false = ปิด Worker)
AUTO_RELEASE_DAYS=7
AUTO_RELEASE_INTERVAL_MINUTES=60
AUTO_RELEASE_ENABLED=true
